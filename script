  );
}

function importSpeakerCategories() {
  const res = UrlFetchApp.fetch(`${TOURNAMENT_URL}/speaker-categories`, {
    method: 'get',
    headers: { authorization: 'Token ' + API_KEY }
  });
  const cats = {};
  JSON.parse(res.getContentText()).forEach(c => {
    cats[c.name.trim().toLowerCase()] = c.url;
    cats[c.slug.trim().toLowerCase()] = c.url;
  });
  return cats;
}

function importInstitutions() {
  const url = `${BASE_URL}/institutions`;
  Logger.log("Fetching institutions from URL: " + url);
  
  const req = UrlFetchApp.fetch(url, {
    method: 'get',
    contentType: 'application/json',
    headers: {
      authorization: 'Token ' + API_KEY
    }
  });

  Logger.log("Response Code: " + req.getResponseCode());
  const responseText = req.getContentText();
  Logger.log("Response Text: " + responseText);
  
  if (req.getResponseCode() == 200) {
    try {
      const insts = {};
      const data = JSON.parse(responseText);
      data.forEach(({ name, url }) => { insts[name.trim()] = url; });
      return insts;
    } catch (error) {
      Logger.log("Error parsing JSON: " + error);
      throw new Error("Failed to parse institutions JSON");
    }
  } else {
    throw new Error(`Failed to fetch institutions. Response: ${req.getResponseCode()}`);
  }
}

function importJudgeAllocations() {
  const roundsUrl = `${TOURNAMENT_URL}/rounds`;
  const roundsResponse = UrlFetchApp.fetch(roundsUrl, {
    method: 'get',
    contentType: 'application/json',
    headers: {
      authorization: 'Token ' + API_KEY
    }
  });

  const rounds = JSON.parse(roundsResponse.getContentText());

  const judgeAllocations = {};
  const roundNames = [];

  for (const round of rounds) {
    const roundName = `Ronda ${round.seq}`;
    roundNames.push(roundName);

    const panelsUrl = `${TOURNAMENT_URL}/rounds/${round.id}/panels`;
    const panelsResponse = UrlFetchApp.fetch(panelsUrl, {
      method: 'get',
      contentType: 'application/json',
      headers: {
        authorization: 'Token ' + API_KEY
      }
    });

    const panels = JSON.parse(panelsResponse.getContentText());

    for (const panel of panels) {
      for (const adj of panel.adjudicators) {
        const name = adj.adjudicator.name;
        if (!judgeAllocations[name]) {
          judgeAllocations[name] = {};
        }
        judgeAllocations[name][roundName] = "X";
      }
    }
  }

  // Crear hoja o limpiar
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sheet = ss.getSheetByName("ADJ ALLOCATIONS");
  if (!sheet) {
    sheet = ss.insertSheet("ADJ ALLOCATIONS");
  } else {
    sheet.clearContents();
  }

  // Encabezados
  const headers = ["Nombre de la jueza", ...roundNames];
  const data = [headers];

  // Ordenar nombres de juezas
  const sortedNames = Object.keys(judgeAllocations).sort();

  for (const name of sortedNames) {
    const row = [name];
    for (const round of roundNames) {
      row.push(judgeAllocations[name][round] || "");
    }
    data.push(row);
  }

  // Escribir a la hoja
  sheet.getRange(1, 1, data.length, data[0].length).setValues(data);
}