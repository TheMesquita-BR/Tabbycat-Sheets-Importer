const { BASE_URL, TOURNAMENT_SLUG, API_KEY } = PropertiesService.getScriptProperties().getProperties();
const TOURNAMENT_URL = `${BASE_URL}/tournaments/${TOURNAMENT_SLUG}`;

let options = {
  method: 'post',
  contentType: 'application/json',
  headers: {
    authorization: 'Token ' + API_KEY
  }
};


function exportInstitutions() {
  const subs = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("INSTITUTIONS").getDataRange().getValues();
  subs.shift(); // remove o cabeçalho

  for (const [name, code, region] of subs) {
    if (!name) continue;

    options.payload = JSON.stringify({
      name,
      code,
      region,
    });

    const url = `${BASE_URL}/institutions`;
    Logger.log(`Sending institution data to: ${url}`);
    
    const req = UrlFetchApp.fetch(url, options);
    const responseCode = req.getResponseCode();
    Logger.log("Response Code: " + responseCode);

    if (responseCode == 201) {
      Logger.log(`Imported (i): ${name}`);
    } else {
      const responseText = req.getContentText();
      Logger.log(`Error importing institution: ${responseText}`);
      throw new Error(`Failed to import institution. Response: ${responseCode}`);
    }
  }
}

function exportTeams() {
  const institutions = importInstitutions();
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("TEAMS");
  const allValues = sheet.getDataRange().getValues();
  const headers = allValues.shift();

  // --- Categorias de orador (nome/slug -> URL), embutido ---
  const catsRes = UrlFetchApp.fetch(`${TOURNAMENT_URL}/speaker-categories`, {
    method: 'get',
    headers: { authorization: 'Token ' + API_KEY }
  });
  const speakerCats = {};
  JSON.parse(catsRes.getContentText()).forEach(c => {
    speakerCats[c.name.trim().toLowerCase()] = c.url;
    speakerCats[c.slug.trim().toLowerCase()] = c.url;
  });

  const toCatUrls = (str) => {
    if (!str) return [];
    return String(str).split(',')
      .map(c => c.trim().toLowerCase())
      .filter(Boolean)
      .map(c => {
        const url = speakerCats[c];
        if (!url) Logger.log(`Categoria não encontrada: "${c}"`);
        return url;
      })
      .filter(Boolean);
  };

  // --- Mapeamento de cabeçalhos ---
  const getColIndex = (colName) => headers.indexOf(colName);

  const TEAM_NAME_COL = getColIndex('teamName');
  const INST_NAME_COL = getColIndex('instName');
  const CODE_NAME_COL = getColIndex('codeName');
  const FULLNAME1_COL = getColIndex('fullName1');
  const EMAIL1_COL = getColIndex('email1');
  const GENDER1_COL = getColIndex('gender1');
  const CAT1_COL = getColIndex('cat1');
  const FULLNAME2_COL = getColIndex('fullName2');
  const EMAIL2_COL = getColIndex('email2');
  const GENDER2_COL = getColIndex('gender2');
  const CAT2_COL = getColIndex('cat2');

  for (const row of allValues) {
    const teamName = row[TEAM_NAME_COL];
    const instName = row[INST_NAME_COL];
    const codeName = CODE_NAME_COL >= 0 ? String(row[CODE_NAME_COL] ?? '').trim() : '';
    const fullName1 = row[FULLNAME1_COL];
    const email1 = row[EMAIL1_COL];
    const gender1 = row[GENDER1_COL];
    const cat1 = row[CAT1_COL];
    const fullName2 = row[FULLNAME2_COL];
    const email2 = row[EMAIL2_COL];
    const gender2 = row[GENDER2_COL];
    const cat2 = row[CAT2_COL];

    if (!fullName1 || !fullName2) continue;

    const institution = instName?.trim() ? (institutions[instName.trim()] ?? null) : null;

    const speakers = [
      {
        name: fullName1.trim(),
        email: email1?.trim() || '',
        phone: '',
        gender: gender1?.trim() || '',
        categories: toCatUrls(cat1)
      },
      {
        name: fullName2.trim(),
        email: email2?.trim() || '',
        phone: '',
        gender: gender2?.trim() || '',
        categories: toCatUrls(cat2)
      }
    ];

    options.payload = JSON.stringify({
      reference: teamName,
      code_name: codeName || `${fullName1.split(' ')[1]} & ${fullName2.split(' ')[1]}`,
      institution,
      speakers,
      use_institution_prefix: false,
      break_categories: [],
      institution_conflicts: [],
    });

    const teamReq = UrlFetchApp.fetch(`${TOURNAMENT_URL}/teams`, { ...options, muteHttpExceptions: true });
    const teamResponseCode = teamReq.getResponseCode();
    Logger.log("Team Response Code: " + teamResponseCode);

    if (teamResponseCode == 201) {
      Logger.log(`Imported (t): ${teamName}`);
    } else {
      Logger.log(`Error importing team "${teamName}": ${teamReq.getContentText()}`);
      throw new Error(`Failed to import team. Response: ${teamResponseCode}`);
    }
  }
}


function exportAdjudicators() {
  const institutions = importInstitutions();
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("ADJ");
  if (!sheet) throw new Error('No se encontró la hoja "ADJ".');

  // obtener todos los valores y quitar la primera fila (headers)
  const all = sheet.getDataRange().getValues();
  const rows = all.slice(1); // <-- evita intentar importar la fila de encabezado

  function mapGender(g) {
    if (!g) return '';
    g = String(g).trim().toUpperCase();
    if (g === 'M') return 'M';
    if (g === 'F') return 'F';
    if (g === 'O') return 'O';
    return ''; // fallback si viene otro valor
  }

  function isValidEmail(e) {
    if (!e) return false;
    // validación básica que cubre la mayoría de casos
    const re = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    return re.test(e);
  }

  // opcional: preparar hoja para listar emails inválidos (descomenta si quieres)
  // let invalidSheet;
  // try { invalidSheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('INVALID_EMAILS') || SpreadsheetApp.getActiveSpreadsheet().insertSheet('INVALID_EMAILS'); }
  // catch(e){ invalidSheet = null; }

  for (let i = 0; i < rows.length; i++) {
    const row = rows[i];
    const [name, instName, score, email, gender] = row;

    // si no hay nombre, saltar (filas vacías)
    if (!name || String(name).trim() === '') continue;

    let institution = null;
    let independent = false;

    if (instName && institutions[instName.trim()]) {
      institution = institutions[instName.trim()];
    } else {
      independent = true;
    }

    // normalizar email
    const rawEmail = email ? String(email).trim() : '';
    let cleanEmail = rawEmail ? rawEmail.toLowerCase() : '';

    // si hay texto pero no es un email válido, lo dejamos vacío y lo registramos
    if (cleanEmail && !isValidEmail(cleanEmail)) {
      Logger.log(`Fila ${i+2}: Email inválido para "${name}": "${rawEmail}". Enviando cadena vacía en su lugar.`);
      // Si prefieres saltar la fila en vez de enviar email vacío, descomenta la línea siguiente:
      // continue;

      // registrar en hoja opcional:
      // if (invalidSheet) invalidSheet.appendRow([new Date(), i+2, name, rawEmail]);
      cleanEmail = ''; // enviar vacío para evitar el error de la API
    }

    options.payload = JSON.stringify({
      name: String(name).trim(),
      institution: institution,
      phone: '',
      email: cleanEmail,                     // email validado/limpio o ''
      base_score: parseFloat(score) || 0.0,
      independent: independent,
      adj_core: false,
      gender: mapGender(gender),             // male/female/other o ''
      institution_conflicts: [],
      team_conflicts: [],
      adjudicator_conflicts: [],
    });

    const adjReq = UrlFetchApp.fetch(`${TOURNAMENT_URL}/adjudicators`, { ...options, muteHttpExceptions: true });
    const adjResponseCode = adjReq.getResponseCode();
    Logger.log("Adjudicator Response Code: " + adjResponseCode);

    if (adjResponseCode == 201) {
      Logger.log(`Imported (a): ${name}`);
    } else {
      const adjResponseText = adjReq.getContentText();
      Logger.log(`Error importing adjudicator: ${adjResponseText}`);
      throw new Error(`Failed to import adjudicator. Response: ${adjResponseCode}`);
    }
  }
}

